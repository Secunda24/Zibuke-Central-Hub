{
  "name": "angel-core",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5000",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "ai:refresh": "node scripts/refresh-ai-knowledge.mjs",
    "db:collab:local": "wrangler d1 execute zibuke-central-prod --local --file=./migrations/001_collaboration_upgrade.sql",
    "db:collab:remote": "wrangler d1 execute zibuke-central-prod --remote --file=./migrations/001_collaboration_upgrade.sql",
    "db:announcements:local": "wrangler d1 execute zibuke-central-prod --local --file=./migrations/002_announcements_upgrade.sql",
    "db:announcements:remote": "wrangler d1 execute zibuke-central-prod --remote --file=./migrations/002_announcements_upgrade.sql",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "build:cloudflare": "node scripts/cloudflare-release.mjs --build-only",
    "deploy:cloudflare": "npm run preflight:cloudflare && node scripts/cloudflare-release.mjs",
    "check:cloudflare": "npm run preflight:cloudflare && node scripts/cloudflare-release.mjs --dry-run",
    "types:cloudflare": "node scripts/generate-cloudflare-types.mjs",
    "preflight:cloudflare": "node scripts/cloudflare-preflight.mjs"
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.24",
    "@livekit/components-styles": "^1.2.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "bcryptjs": "^3.0.3",
    "groq-sdk": "^1.6.0",
    "jose": "^6.2.12",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.1",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.28.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "exceljs": "^4.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.134.0"
  }
}
